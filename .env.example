# ===========================================================
# Discourse Environment Configuration
# ===========================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to a public repository!

# Required: Your Discourse domain name
DISCOURSE_HOSTNAME=your-domain.com

# Required: Admin/developer email addresses (comma-separated)
DISCOURSE_DEVELOPER_EMAILS=admin@your-domain.com

# Required: SMTP mail server configuration
DISCOURSE_SMTP_ADDRESS=smtp.your-provider.com
DISCOURSE_SMTP_PORT=587
DISCOURSE_SMTP_USER_NAME=smtp-user@your-domain.com
DISCOURSE_SMTP_PASSWORD=your-smtp-password
DISCOURSE_SMTP_ENABLE_START_TLS=true
DISCOURSE_SMTP_OPENSSL_VERIFY_MODE=none

# Optional: Number of web workers (default: 4)
UNICORN_WORKERS=4

# Optional: Host port for Discourse (default: 80)
DISCOURSE_PORT=80
